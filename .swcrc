{
    "$schema": "https://json.schemastore.org/swcrc",
    "sourceMaps": true,
    "module": {
        "type": "commonjs"
    },
    "jsc": {
        "target": "esnext",
        "parser": {
            "syntax": "typescript",
            "decorators": true,
            "dynamicImport": true
        },
        "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
        },
        "keepClassNames": true,
        "baseUrl": "./",
        "paths": {
            "@modules/*": [
                "./src/modules/*"
            ],
            "@common/*": [
                "./src/common/*"
            ],
            "@infrastructure/*": [
                "./src/infrastructure/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ]
        }
    },
    "minify": false
}
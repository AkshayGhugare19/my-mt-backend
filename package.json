  "scripts": {
    "build": "npx prisma generate && nest build -b swc",
    "build:watch": "npx swc --out-dir dist -w src",
    "typecheck": "tsc --noEmit --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" ",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prepare": "husky install",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch -b swc & npm run typecheck",
    "start:dev": "nest start --watch -b swc & npm run typecheck",
    "start:prod": "node dist/main",
    "start:repl": "npx nest start -b swc -w -p ./tsconfig.repl.json --entryFile repl",
    "cmd": "node ./dist/cli.js",
    "cmd:update-slotegrator": "npm run cmd -- update-slotegrator",
    "cmd:update-slotegrator-category": "npm run cmd -- update-slotegrator-category",
    "cmd:invalidate-permission-cache": "npm run cmd -- invalidate-permission-cache",
    "cmd:set-secret": "npm run cmd -- set-secret",
    "cmd:seed": "npm run cmd -- seed",
    "cmd:test-sportsbook": "node ./dist/cmd/slotegrator-local-test/cli.js test-sportsbook",
    "codegen:filters": "ts-node --transpile-only ./src/meta/filters/generator",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
